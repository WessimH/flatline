// FLA-22: an output never seen appears and becomes the default: the
// "New output" banner asks which headphones are on it. Then a second
// Scarlett with the same name (another UID) is also a new output.
(
    settings: Some((
        onboarded: true,
        version: 6,
        headphone_outputs: [
            (uid: "AppleUSBAudioEngine:Focusrite:Scarlett Solo USB:1", name: "Scarlett Solo USB", headphones: "oratory1990/Beyerdynamic DT 770 Pro"),
        ],
    )),
    devices: [
        ("BuiltInSpeakerDevice", "MacBook Pro Speakers"),
        ("AppleUSBAudioEngine:Focusrite:Scarlett Solo USB:1", "Scarlett Solo USB"),
    ],
    default: Some("AppleUSBAudioEngine:Focusrite:Scarlett Solo USB:1"),
    steps: [
        (at: 3, events: [Add("AA-BB-CC-DD-EE-FF:output", "WH-1000XM5"), Default(Some("AA-BB-CC-DD-EE-FF:output"))]),
        (at: 6, events: [Add("AppleUSBAudioEngine:Focusrite:Scarlett Solo USB:2", "Scarlett Solo USB"), Default(Some("AppleUSBAudioEngine:Focusrite:Scarlett Solo USB:2"))]),
    ],
)
